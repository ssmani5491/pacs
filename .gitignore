# secrets / env
.env
*.local
# rotated test-account credentials (F-02 remediation) — never commit
tests/.credentials.local

# node
node_modules/
dist/
build/
.vite/
coverage/
*.log

# prisma
backend/prisma/*.db

# docker volumes (if bind-mounted locally)
data/
backups/

# DICOM / PHI — never commit images or real data
*.dcm
seed/dicom/*.dcm
replica/screens/

# certs / keys
*.pem
*.key

# archives / dumps / backups — never commit (security audit, 2026-11-19)
*.zip
*.tar
*.tar.gz
*.bak
*.dump

# OS
.DS_Store
Thumbs.db

# all-in-one deployment secrets (also covers throwaway test-* variants used
# for isolated smoke-test runs, e.g. deploy/allinone/test-db_password.txt)
deploy/allinone/*db_password.txt
deploy/allinone/*rispacs.ini
deploy/allinone/data/
deploy/allinone/test-data/
dist/

# throwaway smoke-test workspaces (Jenkinsfile Smoke Test stage, and local
# manual re-runs of it) — generated CI-only secrets, never committed
/ci-smoke/
/ci-smoke-manual/
