# ============================================================
#  RIS + PACS Replica — environment template
#  Copy to .env and change every secret before any real use.
#  Nothing here is a production secret. Do NOT commit .env.
# ============================================================

# ---- Application ports (host side) ----
FRONTEND_PORT=8080
BACKEND_PORT=3000
NGINX_PORT=80
NGINX_TLS_PORT=443

# ---- PostgreSQL (two logical DBs on one server) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pacs
POSTGRES_PASSWORD=change-me-postgres
RIS_DB_NAME=ris
ORTHANC_DB_NAME=orthanc
# Prisma connection string for the RIS database
DATABASE_URL=postgresql://pacs:change-me-postgres@postgres:5432/ris?schema=public

# ---- Redis (jobs, refresh-token revocation) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900           # seconds (15 min)
JWT_REFRESH_TTL=604800       # seconds (7 days)
PASSWORD_PEPPER=change-me-optional-pepper

# ---- Initial super admin (seed only — see F-02 remediation) ----
# REQUIRED the first time the application seeds a fresh database (no existing
# 'admin' user): the seed REFUSES to create the account if this is unset or
# shorter than 8 characters (matching the application's existing password
# policy) — there is NO default and NO fallback. Inject it from your own
# secret store at deploy time (e.g. a secrets manager, a vault-populated .env,
# or an operator-entered value); never commit a real value here.
# Once the admin account exists, this variable is not read again on restart —
# re-seeding never changes an existing admin's password, role, org, or status.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=itdept@example.local
SEED_ADMIN_PASSWORD=

# ---- Orthanc / DICOM ----
ORTHANC_URL=http://orthanc:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=change-me-orthanc
ORTHANC_AET=GGHPACS
ORTHANC_DICOM_PORT=4242           # C-STORE SCP port
DICOMWEB_ROOT=/dicom-web          # served via nginx -> orthanc

# ---- Storage ----
DICOM_STORAGE_PATH=/var/lib/orthanc/db
APP_LOG_PATH=/var/log/pacs
BACKUP_PATH=/var/backups/pacs
ARCHIVE_ROOT=/var/lib/pacs/archive
# Read-only Orthanc storage mount the nightly backup job archives (Phase 1D).
ORTHANC_STORAGE_RO_PATH=/var/lib/orthanc-storage-ro
# Backend URL Orthanc's on-stored.lua posts ingest notifications to.
INGEST_BACKEND_URL=http://backend:3000

# ---- Nightly backup (Product Validation Phase 1D) ----
# Cron expression for the nightly backup job (default: 02:00 server time).
BACKUP_CRON=0 2 * * *
# How many days of completed backup files to retain before automatic deletion.
BACKUP_RETENTION_DAYS=30
# Minimum free disk space (MB) required on the backup volume before a run starts.
BACKUP_MIN_FREE_MB=500

# ---- Misc ----
NODE_ENV=development
TZ=Asia/Kolkata

# ---- Ingest (Orthanc -> backend) ----
INGEST_SECRET=change-me-ingest-secret
MWL_AET=GGHMWL
MWL_PORT=4243
INSTITUTION_NAME=GG Hospital
