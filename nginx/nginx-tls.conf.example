# TLS-ready production NGINX configuration EXAMPLE (Phase 9).
#
# This is a template, NOT wired into docker-compose. The live deployment runs
# plain HTTP locally (nginx/nginx.conf). To enable HTTPS in production:
#   1. Obtain certs (e.g. internal CA or Let's Encrypt) -> /etc/nginx/certs/.
#   2. Mount this file as /etc/nginx/nginx.conf and the certs volume.
#   3. Publish 443; set HSTS_ENABLED=true for the backend (main.ts) OR rely on
#      the HSTS header below (do NOT enable HSTS until HTTPS actually works).
#   4. Keep the dynamic-DNS resolver + variable upstreams from nginx.conf.
#
# Everything below mirrors nginx.conf (same dynamic DNS, same routes) plus TLS.

worker_processes auto;
events { worker_connections 1024; }

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  sendfile on;
  client_max_body_size 2g;

  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 5s;
  proxy_connect_timeout 5s;
  proxy_send_timeout 60s;
  proxy_read_timeout 60s;

  map $http_upgrade $connection_upgrade { default upgrade; '' close; }

  # Redirect all HTTP to HTTPS.
  server {
    listen 80;
    server_name _;
    location = /healthz { return 200 "ok\n"; add_header Content-Type text/plain; }
    location / { return 301 https://$host$request_uri; }
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    # HSTS is SAFE here because this block is HTTPS-only.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ... copy the location blocks from nginx.conf verbatim (/, /api/, /api/dicom-web/,
    # /viewer/, /socket.io/, /dicom-web/, /healthz), which already use the dynamic-DNS
    # variable-upstream pattern and therefore need no change under TLS. The SPA security
    # headers in the "/" block apply unchanged.
  }
}
