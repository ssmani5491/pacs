; RIS + PACS — single configuration file.
; Copy to /data/config/rispacs.ini (or mount at /etc/rispacs/rispacs.ini) and
; edit every value marked CHANGE ME before starting the container.
;
; The database password lives in a SEPARATE file, db_password.txt, next to
; docker-compose.yml — not in this .ini file. See db_password.txt.example.

[server]
; The IP or hostname your staff and modalities actually use to reach this
; server. Used to derive CORS_ORIGINS automatically (see extra_origins below
; for additional hostnames).
public_host = 192.168.1.50      ; CHANGE ME
http_port = 80
timezone = Asia/Kolkata
; Comma-separated extra origins (e.g. a DNS hostname in addition to the IP).
; Leave blank if public_host is the only way staff reach this server.
extra_origins =

[dicom]
ae_title = RISPACS
dicom_port = 4242
; Modalities are reached through Docker's NAT unless the container runs with
; host networking, so Orthanc's own reachability check for the calling AE's
; host is disabled by default — see deploy/allinone/README.md.
check_modality_host = false

[mwl]
; Modality Worklist SCP (C-FIND) — separate AE title and port from [dicom],
; matching this project's existing mwl-scp service.
ae_title = RISMWL
port = 4243

[database]
; The password itself is NOT set here — it lives in one file, db_password.txt
; (see docker-compose.yml, POSTGRES_PASSWORD_FILE), read by both the postgres
; container and this one's entrypoint. This also means host can point at an
; EXTERNAL Postgres server (not just the bundled sibling container) as long
; as db_password.txt matches that server's password for this user.
host = postgres
port = 5432
user = pacs
ris_db = ris
orthanc_db = orthanc

[admin]
; Initial super-admin account, created only on first boot (never touches an
; already-existing admin account on restart — see README).
seed_username = admin
seed_email = admin@example.local
seed_password = change-me         ; CHANGE ME (min 8 characters)

[services_ui]
; supervisord's web UI, proxied by nginx at /admin/services/.
user = admin
password = change-me              ; CHANGE ME

[orthanc]
username = orthanc
password = change-me              ; CHANGE ME

[storage]
; All paths below are fixed inside the container; only the host-side bind
; mount for /data changes between deployments.
compress = true

[backup]
; Reuses the backend's existing nightly backup feature (Product Validation
; Phase 1D) — not a second, competing backup system.
cron = 0 2 * * *
retention_days = 30
min_free_mb = 500

[backend]
; Leave blank to auto-generate on first boot and persist in
; /data/config/secrets.env (recommended). Set explicitly only if you need a
; fixed value across a redeploy from scratch.
jwt_access_secret =
jwt_refresh_secret =
password_pepper =
